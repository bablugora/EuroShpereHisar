RewriteEngine On

# 1. Force HTTPS and WWW (Sitemap & Search Console se match karne ke liye)
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} !^www\. [NC]
RewriteCond %{HTTP_HOST} ^(?:www\.)?(.*)$ [NC]
RewriteRule ^ https://www.foreignlanguagehub.com%{REQUEST_URI} [L,R=301]

# 2. index.html ko direct root domain (/) par redirect karein
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /index\.html\ [NC]
RewriteRule ^index\.html$ https://www.foreignlanguagehub.com/ [R=301,L]

# 3. Direct .html URL ko clean URL (without .html) par redirect karein
RewriteCond %{THE_REQUEST} \s/+(.+)\.html[\s?] [NC]
RewriteRule ^ %1 [R=301,L]

# 4. Internal rewrite: clean URL se piche .html file load karein
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^(.*)$ $1.html [L]

# Browser Caching
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
</IfModule>